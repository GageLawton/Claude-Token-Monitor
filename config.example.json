{
  "_comment": "Pi config — save as ~/.config/ctm/config.json on the Raspberry Pi",

  "plan": "pro",
  "refresh_interval_seconds": 30,
  "notify_on_reset": true,
  "notify_threshold_percent": 80,

  "ingest_server": {
    "enabled": true,
    "bind_host": "0.0.0.0",
    "bind_port": 7373,
    "shared_secret": "run-ctm-gen-secret-to-generate-this",
    "rate_limit_per_minute": 120
  },

  "log_file": "/home/pi/.ctm.log",
  "log_max_size_mb": 10,
  "log_keep_files": 3,

  "state_file": "/home/pi/.cache/ctm/state.jsonl",

  "email": {
    "enabled": true,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "username": "you@gmail.com",
    "password": "your-gmail-app-password",
    "from": "you@gmail.com",
    "to": "notify@youremail.com"
  },

  "_comment2": "Optional: ntfy.sh push notifications (no account needed for public topics)",
  "webhook": {
    "enabled": false,
    "url": "https://ntfy.sh/my-ctm-alerts",
    "method": "POST",
    "title_header": "X-Title"
  }
}
